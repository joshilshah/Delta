# Root reference. Copy each block into the matching file:
#   frontend/.env   (Vite only exposes variables prefixed with VITE_)
#   backend/.env
# NEVER put SUPABASE_SECRET_KEY or GOOGLE_MAPS_SERVER_KEY in the frontend. Never commit real values.

# ---------- frontend/.env ----------
VITE_API_BASE_URL=http://localhost:3000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_MAPS_BROWSER_KEY=

# ---------- backend/.env ----------
PORT=3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
GOOGLE_MAPS_SERVER_KEY=
FRONTEND_ORIGIN=http://localhost:5173
